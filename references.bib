@techreport{mondon_outlier_2021,
  title = {Outlier detection using {{ICS}} for compositional data},
  author = {Mondon, Camille},
  year = 2021,
  month = oct,
  address = {Toulouse, France},
  institution = {Toulouse School of Economics (TSE)},
  url = {https://camillemondon.com/publications/2023/ics-coda/Outlier_detection_using_ICS_for_compositional_data.pdf},
  abstract = {A multivariate data set for which each variable can be interpreted as part of a whole is called a compositional data set. In that case, it is preferable to decrease by one the dimension and consider it as embedded in the simplex, which is equipped with its own Euclidian structure. Thus, adapting a method such as Invariant Coordinate Selection (ICS) to compositional data is an interesting challenge since ICS has proved itself useful on classical multivariate data sets to reveal hidden structures such as outliers or groups, but cannot be applied as such on the simplex. This internship report summarises the main aspects of compositional data analysis and algebra, in order to adapt the ICS method to outlier detection for compositional data.},
  langid = {english}
}

