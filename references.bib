  title = {An {{RKHS}} framework for functional data analysis},
  author = {Kupresanin, Ana and Shin, Hyejin and King, David and Eubank, R. L.},
  year = 2010,
  month = dec,
  journal = {J. Stat. Plan. Inference},
  series = {Special {{Issue}} in {{Honor}} of {{Emanuel Parzen}} on the {{Occasion}} of his 80th {{Birthday}} and {{Retirement}} from the {{Department}} of {{Statistics}}, {{Texas A}}\&{{M University}}},
  volume = {140},
