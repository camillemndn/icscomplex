@misc{clavier_towards_2023,
  title = {Towards {{Minimax Optimality}} of {{Model}}-based {{Robust Reinforcement Learning}}},
  author = {Clavier, Pierre and Pennec, Erwan Le and Geist, Matthieu},
  year = 2023,
  month = feb,
  number = {arXiv:2302.05372},
  eprint = {2302.05372},
  primaryclass = {cs, stat},
  publisher = {arXiv},
  doi = {10.48550/arXiv.2302.05372},
  urldate = {2023-05-30},
  abstract = {We study the sample complexity of obtaining an \$\textbackslash epsilon\$-optimal policy in \textbackslash emph\textbraceleft Robust\textbraceright{} discounted Markov Decision Processes (RMDPs), given only access to a generative model of the nominal kernel. This problem is widely studied in the non-robust case, and it is known that any planning approach applied to an empirical MDP estimated with \$\textbackslash tilde\textbraceleft\textbackslash mathcal\textbraceleft O\textbraceright\textbraceright (\textbackslash frac\textbraceleft H\textasciicircum 3 \textbackslash mid S \textbackslash mid\textbackslash mid A \textbackslash mid\textbraceright\textbraceleft\textbackslash epsilon\textasciicircum 2\textbraceright )\$ samples provides an \$\textbackslash epsilon\$-optimal policy, which is minimax optimal. Results in the robust case are much more scarce. For \$sa\$- (resp \$s\$-)rectangular uncertainty sets, the best known sample complexity is \$\textbackslash tilde\textbraceleft\textbackslash mathcal\textbraceleft O\textbraceright\textbraceright (\textbackslash frac\textbraceleft H\textasciicircum 4 \textbackslash mid S \textbackslash mid\textasciicircum 2\textbackslash mid A \textbackslash mid\textbraceright\textbraceleft\textbackslash epsilon\textasciicircum 2\textbraceright )\$ (resp. \$\textbackslash tilde\textbraceleft\textbackslash mathcal\textbraceleft O\textbraceright\textbraceright (\textbackslash frac\textbraceleft H\textasciicircum 4 \textbackslash mid S \textbackslash mid\textasciicircum 2\textbackslash mid A \textbackslash mid\textasciicircum 2\textbraceright\textbraceleft\textbackslash epsilon\textasciicircum 2\textbraceright )\$), for specific algorithms and when the uncertainty set is based on the total variation (TV), the KL or the Chi-square divergences. In this paper, we consider uncertainty sets defined with an \$L\_p\$-ball (recovering the TV case), and study the sample complexity of \textbackslash emph\textbraceleft any\textbraceright{} planning algorithm (with high accuracy guarantee on the solution) applied to an empirical RMDP estimated using the generative model. In the general case, we prove a sample complexity of \$\textbackslash tilde\textbraceleft\textbackslash mathcal\textbraceleft O\textbraceright\textbraceright (\textbackslash frac\textbraceleft H\textasciicircum 4 \textbackslash mid S \textbackslash mid\textbackslash mid A \textbackslash mid\textbraceright\textbraceleft\textbackslash epsilon\textasciicircum 2\textbraceright )\$ for both the \$sa\$- and \$s\$-rectangular cases (improvements of \$\textbackslash mid S \textbackslash mid\$ and \$\textbackslash mid S \textbackslash mid\textbackslash mid A \textbackslash mid\$ respectively). When the size of the uncertainty is small enough, we improve the sample complexity to \$\textbackslash tilde\textbraceleft\textbackslash mathcal\textbraceleft O\textbraceright\textbraceright (\textbackslash frac\textbraceleft H\textasciicircum 3 \textbackslash mid S \textbackslash mid\textbackslash mid A \textbackslash mid \textbraceright\textbraceleft\textbackslash epsilon\textasciicircum 2\textbraceright )\$, recovering the lower-bound for the non-robust case for the first time and a robust lower-bound when the size of the uncertainty is small enough.},
  archiveprefix = {arXiv},
  keywords = {Computer Science - Machine Learning,Statistics - Machine Learning}
}

@misc{climate_prediction_centernational_centers_for_environmental_predictionnational_weather_servicenoaaus_department_of_commerce_cpc_1987,
