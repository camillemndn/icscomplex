  abstract = {According to the correspondence relationship between the base coefficients of fitting curves and the functional data, this paper proposed a method of outlier detection for functional data. The principle is to use MCD algorithm in multivariate data to detect the outliers of the base coefficients of fitting curves, and then correspond the detection result with the functional data to realize the process of outlier detection of functional data. Since the base coefficients of the functional data can express most of the information of the original functional data, the outlier detection of the base coefficients of the functional data with MCD algorithm can take into account both the overall anomaly and the local anomaly of the functional data. In the simulation part, this method is applied to the outlier detection of functional data of air quality, and compared with the outlier detection method based on statistical depth. The results show that the proposed method is more appropriate for detecting outliers in air quality data.},
  keywords = {Air quality,Anomaly detection,Data models,Economics,Functional data,MCD algorithm,Outliers,Splines (mathematics),Statistical analysis,Stochastic processes}
}

