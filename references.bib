@article{binding_canonical_1989,
  title = {A canonical form for self-adjoint pencils in {{Hilbert}} space},
  author = {Binding, Paul},
  year = 1989,
  month = may,
  journal = {Integral Equ. Oper. Theory},
  volume = {12},
  number = {3},
  pages = {324--342},
  issn = {1420-8989},
  doi = {10.1007/BF01235736},
  urldate = {2026-08-27},
  abstract = {We characterize those pencils P={$\lambda$}A-B of operators on a separable Hilbert space H for which a linear homeomorphism D of H exists satisfying the following: (i) H decomposes into a direct sum F+G, orthogonal in a (perhaps indefinite) inner product induced by A, where F is finite dimensional (ii) D*PD=PF{$\oplus$}({$\lambda$}IG-C) where PF is a (congruence) canonical form for the general self-adjoint pencil on F, and C is a bounded self-adjoint operator on G. For a given P, explicit constructions are given for C, D, F, G and PF.},
  langid = {english},
  keywords = {Canonical Form,Explicit Construction,Hilbert Space,Linear Homeomorphism,Separable Hilbert Space}
}

@article{binding_root_1987,
  title = {On root vectors of self-adjoint pencils},
  author = {Binding, P. A and Seddighi, K},
  year = 1987,
  month = jan,
  journal = {J. Funct. Anal.},
  volume = {70},
  number = {1},
  pages = {117--125},
  issn = {0022-1236},
  doi = {10.1016/0022-1236(87)90126-1},
  urldate = {2026-09-16},
  abstract = {Let A and C be compact symmetric operators on a Hilbert space H, and let B = I + C be 1 - 1. Then the eigenvectors for the generalised eigenvalue problem (A - {$\lambda$}B)x = 0 {$\neq$} x {$\epsilon$} H, and the associated root vectors, coincide with those of the operator Q = B-1 A which is self-adjoint in the Pontryagin space HB under the inner product given by (x, y)B = (x, By). The main result is equivalence of (i) completeness of these root vectors in H; (ii) nondegeneracy of a particular root subspace L of Q in HB; (iii) decomposability of HB into a Q-invariant orthogonal direct sum F{$\oplus$}B G{$\oplus$}B L, where dim F is finite and GB is a Hilbert space. This includes Iohvidov's theorem, a complete proof of which we could not find in print. In addition to precise bounds on dim F, we also give various special cases and related results, e.g., for the case where A is self-adjoint and bounded below with compact resolvent, and B is bounded and symmetric.}
}

