@article{sain_functional_2011,
  title = {Functional {{ANOVA}} and regional climate experiments: a statistical analysis of dynamic downscaling},
  shorttitle = {Functional {{ANOVA}} and regional climate experiments},
  author = {Sain, Stephan R. and Nychka, Doug and Mearns, Linda},
  year = 2011,
  journal = {Environmetrics},
