@article{ferraty_functional_2002,
  title = {The {{Functional Nonparametric Model}} and {{Application}} to {{Spectrometric Data}}},
  author = {Ferraty, Fr{\'e}d{\'e}ric and Vieu, Philippe},
  year = 2002,
