@article{greco_finite_2022,
  title = {Finite {{Mixtures}} of {{Multivariate Wrapped Normal Distributions}} for {{Model Based Clustering}} of p-{{Torus Data}}},
  author = {Greco, Luca and Novi Inverardi, Pier Luigi and Agostinelli, Claudio},
  year = 2022,
