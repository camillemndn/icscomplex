@article{martin-fernandez_units_2021,
  title = {Units {{Recovery Methods}} in {{Compositional Data Analysis}}},
  author = {{Mart{\'i}n-Fern{\'a}ndez}, J. A. and Egozcue, J. J. and Olea, R. A. and {Pawlowsky-Glahn}, V.},
