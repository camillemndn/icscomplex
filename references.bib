@misc{patane_random_2026,
  title = {Random mixtures in {{Bayes Hilbert}} spaces},
  author = {Patan{\`e}, Giulia and Greven, Sonja and Menafoglio, Alessandra},
  year = 2026,
  month = sep,
  number = {arXiv:2609.03523},
  eprint = {2609.03523},
  primaryclass = {stat.ME},
