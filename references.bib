@article{marron_visual_1995,
  title = {Visual {{Error Criteria}} for {{Qualitative Smoothing}}},
  author = {Marron, J. S. and {and Tsybakov}, A. B.},
  year = 1995,
  month = jun,
  journal = {J. Am. Stat. Assoc.},
